# Environment Configuration Example
# Copy to .env for local overrides (never commit .env to version control)

APP_NAME=ai-devops-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# AWS Deployment Configuration (Used by CI/CD secrets or local deployment tools)
AWS_REGION=us-east-1
EC2_INSTANCE_TYPE=t2.micro
